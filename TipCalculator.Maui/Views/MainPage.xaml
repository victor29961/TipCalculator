<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipCalculator.Maui.Views.MainPage"
             Title="Calculadora de propina">
    <Grid
        RowDefinitions="Auto,Auto,Auto" 
        ColumnDefinitions="*"
         Padding="24"
          RowSpacing="16">

        <Border
            Grid.Row="0"
            Grid.Column="0">


            <Grid
                RowDefinitions="*,*,*,*"
                ColumnDefinitions="Auto,*,Auto"
                Padding="16"
                RowSpacing="8"
                ColumnSpacing="8">
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="IMPORTE"
                    HorizontalOptions="End"
                    VerticalOptions="Center"/>
                <Entry
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    BackgroundColor="Black"/>
                <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text=" # de Persona"
                    HorizontalOptions="End"
                    VerticalOptions="Center"/>
                <Entry
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Black"/>
                <Stepper
                    Grid.Row="1"
                    Grid.Column="2"/>


                <HorizontalStackLayout
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalOptions="Center"
                    Spacing="16">

                    <Button
                        Text="8%"
                        WidthRequest="75"/>
                    <Button
                        Text="10%"
                        WidthRequest="75"/>
                    <Button
                        Text="12.5%"
                        WidthRequest="75"/>
                    <Button
                        Text="15%"
                        WidthRequest="75"/>

                </HorizontalStackLayout>


                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="% DE PROPINA"
                    HorizontalOptions="End"
                    VerticalOptions="Center"/>
                <Entry
                    Grid.Row="3"
                    Grid.Column="1"
                    BackgroundColor="Black"/>
                <Stepper
                    Grid.Row="3"
                    Grid.Column="2"/>
            </Grid>

        </Border>


        <HorizontalStackLayout
            Grid.Row="1"
            Grid.Column="0"
            HorizontalOptions="Center"
            Spacing="24">
            <Button
                Text="calular"/>
            <Button
                Text="limpiar"/>
        </HorizontalStackLayout>


        <Border
            Grid.Row="2"
            Grid.Column="0">

            <Grid
                RowDefinitions="*,*,*,*,*,*"
                ColumnDefinitions="*,Auto"
                Padding="16"
                RowSpacing="8"
                ColumnSpacing="4">


                <Label
             Grid.Row="0"
             Grid.Column="0"
             Text="Importe Del Consumo:"/>
                <Label
             Grid.Row="0"
             Grid.Column="1"
             Text="$1,500.00"
             HorizontalTextAlignment="End"/>
                <Label
             Grid.Row="1"
             Grid.Column="0"
             Text="Importe del consumo por persona:"/>
                <Label
             Grid.Row="1"
             Grid.Column="1"
             Text="$500.00"
             HorizontalTextAlignment="End"/>
                <Label
             Grid.Row="2"
             Grid.Column="0"
             Text="Importe de la propina:"/>
                <Label
             Grid.Row="2"
             Grid.Column="1"
             Text="$150.00"
             HorizontalTextAlignment="End"/>
                <Label
             Grid.Row="3"
             Grid.Column="0"
             Text="Propina por persona:"/>
                <Label
             Grid.Row="3"
             Grid.Column="1"
             Text="$50.00"
             HorizontalTextAlignment="End"/>
                <Label
             Grid.Row="4"
             Grid.Column="0"
             Text="Importe total por propina:"/>
                <Label
             Grid.Row="4"
             Grid.Column="1"
             Text="$1,650.00"
             HorizontalTextAlignment="End"/>
                <Label
             Grid.Row="5"
             Grid.Column="0"
             Text="Importe con propina por persona"/>
                <Label
             Grid.Row="5"
             Grid.Column="1"
             Text="$550.00"
             HorizontalTextAlignment="End"/>

            </Grid>

        </Border>

    </Grid>

</ContentPage>